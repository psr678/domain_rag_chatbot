# Copy this file to .env and fill in your own key. Never commit the real .env file.

# Required for answer generation (LLM calls). Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: comma-separated Gemini model names to try, in order (with automatic
# retry + fallback between them -- see rag_pipeline.py). Defaults to
# "gemini-3.6-flash-lite,gemini-3.6-flash" if unset.
# GEMINI_MODEL=gemini-3.6-flash-lite,gemini-3.6-flash
